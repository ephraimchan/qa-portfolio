              "\r",
              "// 2. Extract the response data to verify the content matches what has been created\r",
              "const responseData = pm.response.json();\r",
              "\r",
              "pm.test(\"Verify the data matches what was created\", function () {\r",
              "    // Check that the shape or structure is correct\r",
              "    pm.expect(responseData).to.have.property('id');\r",
              "    pm.expect(responseData).to.have.property('title');\r",
              "    pm.expect(responseData).to.have.property('body');\r",
              "});"
            ],
