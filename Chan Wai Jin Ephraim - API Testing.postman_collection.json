              "});\r",
              "\r",
              "const responseData = pm.response.json();\r",
              "\r",
              "// 2. Verify the specific field you modified changed correctly\r",
              "pm.test(\"Verify updated field changed correctly\", function () {\r",
              "    pm.expect(responseData.title).to.eql(\"This Title has been updated\");\r",
              "});\r",
              "\r",
              "// 3. Verify unchanged fields remained the same (regression check)\r",
              "pm.test(\"Verify unchanged fields remained intact\", function () {\r",
              "    pm.expect(responseData).to.have.property('body');\r",
              "    pm.expect(responseData).to.have.property('userId');\r",
              "    pm.expect(responseData.id).to.eql(pm.environment.get(\"postId\"));\r",
              "});"
            ],
